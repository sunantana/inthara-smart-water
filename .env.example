# ============================================================
# ตัวอย่างไฟล์ตั้งค่า environment — Inthara Smart Water ERP
# วิธีใช้: คัดลอกเป็น .env แล้วแก้ค่า (ห้าม commit ไฟล์ .env)
# บน Render: Dashboard → Environment → Add Environment Variable
# ============================================================

# พอร์ตที่เซิร์ฟเวอร์ฟัง (ค่าเริ่มต้น 3080)
PORT=3080

# development = ใช้ secret จาก data/security_auth.json ได้ (ไม่แนะนำ)
# production  = บังคับต้องมี AUTH_SECRET ไม่อย่างนั้นเซิร์ฟเวอร์จะไม่ยอม start
NODE_ENV=development

# คีย์ลับสำหรับเซ็น/ตรวจ JWT ของพนักงาน (จำเป็นใน production, ยาวอย่างน้อย 32 ตัวอักษร)
# สร้างค่าใหม่ด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# หมายเหตุ: เปลี่ยนค่านี้ = token ที่ผู้ใช้ถืออยู่ทั้งหมดถูกยกเลิก (ทุกคนต้องล็อกอินใหม่)
AUTH_SECRET=

# โดเมนที่อนุญาตให้เรียก API ข้ามโดเมน คั่นด้วยเครื่องหมายจุลภาค
# ตัวอย่าง: https://erp.inthara.co.th,https://portal.inthara.co.th
# ถ้าเว้นว่าง = ไม่เปิด CORS ให้โดเมนภายนอกเลย (ปลอดภัยที่สุดสำหรับการใช้งานปกติ)
CORS_ORIGINS=
