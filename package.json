{
  "name": "inthara-smart-water-erp",
  "version": "1.0.0",
  "description": "ระบบบริหารจัดการโรงงานผลิตน้ำดื่มอินธารา (Inthara Smart Water ERP & TMS GPS Route Optimization)",
  "main": "server.js",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm --workspace server run dev",
    "dev:web": "npm --workspace web run dev",
    "test": "npm --workspace server run test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
