# ==========================================================
# Inthara Smart Water ERP v2 — Backend env (Phase 0)
# คัดลอกไฟล์นี้เป็น server/.env แล้วแก้ค่า
# ห้าม commit ไฟล์ .env (ถูก .gitignore ไว้แล้ว) และห้ามใส่ค่าจริงในไฟล์นี้
# ==========================================================

# พอร์ตของ API (dev ใช้ 3001 เพื่อไม่ชนกับ v1 ที่ใช้ 3080)
PORT=3001

# development | production | test
NODE_ENV=development

# กุญแจเซ็น JWT — จำเป็นใน production (อย่างน้อย 32 ตัวอักษร)
# สร้างค่า: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# โฟลเดอร์เก็บไฟล์ SQLite (relative กับ server/ หรือ absolute ก็ได้)
DATA_DIR=./data
